<div class="customer-page page-width page-width--narrow">
  <h1 class="customer-page__title text-heading">{{ 'customer.register.title' | t }}</h1>

  {%- form 'create_customer', class: 'customer-form' -%}
    {%- if form.errors -%}
      <div class="customer-form__errors" role="alert">
        <ul>
          {%- for field in form.errors -%}
            <li>{{ form.errors.messages[field] }}</li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}

    <div class="customer-form__row">
      <div class="customer-form__field">
        <label class="text-form" for="RegisterFirstName">{{ 'customer.register.first_name' | t }}</label>
        <input type="text" id="RegisterFirstName" name="customer[first_name]" autocomplete="given-name">
      </div>
      <div class="customer-form__field">
        <label class="text-form" for="RegisterLastName">{{ 'customer.register.last_name' | t }}</label>
        <input type="text" id="RegisterLastName" name="customer[last_name]" autocomplete="family-name">
      </div>
    </div>

    <div class="customer-form__field">
      <label class="text-form" for="RegisterEmail">{{ 'customer.register.email' | t }}</label>
      <input type="email" id="RegisterEmail" name="customer[email]" autocomplete="email" required>
    </div>

    <div class="customer-form__field">
      <label class="text-form" for="RegisterPassword">{{ 'customer.register.password' | t }}</label>
      <input type="password" id="RegisterPassword" name="customer[password]" autocomplete="new-password" required>
    </div>

    <button type="submit" class="button button--primary customer-form__submit">{{ 'customer.register.submit' | t }}</button>
  {%- endform -%}

  <p class="customer-page__footer text-caption">
    {{ 'customer.register.already_have_account' | t }}
    <a href="{{ routes.account_login_url }}">{{ 'customer.register.sign_in' | t }}</a>
  </p>
</div>
