<div class="customer-page page-width page-width--narrow">
  <h1 class="customer-page__title text-heading">{{ 'customer.login.title' | t }}</h1>

  {%- form 'customer_login', class: 'customer-form' -%}
    {%- if form.errors -%}
      <div class="customer-form__errors" role="alert">
        <ul>
          {%- for field in form.errors -%}
            <li>{{ form.errors.messages[field] }}</li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}

    <div class="customer-form__field">
      <label class="text-form" for="CustomerEmail">{{ 'customer.login.email' | t }}</label>
      <input type="email" id="CustomerEmail" name="customer[email]" autocomplete="email" autofocus required>
    </div>

    <div class="customer-form__field">
      <label class="text-form" for="CustomerPassword">{{ 'customer.login.password' | t }}</label>
      <input type="password" id="CustomerPassword" name="customer[password]" autocomplete="current-password" required>
    </div>

    <button type="submit" class="button button--primary customer-form__submit">{{ 'customer.login.sign_in' | t }}</button>

    <details class="customer-form__recover">
      <summary class="text-caption">{{ 'customer.login.forgot_password' | t }}</summary>
      <div class="customer-form__recover-content">
        <p class="text-caption">{{ 'customer.login.recover_instructions' | t }}</p>
        {%- form 'recover_customer_password', class: 'customer-form__recover-form' -%}
          {%- if form.posted_successfully? -%}
            <p class="customer-form__success text-caption">{{ 'customer.login.recover_success' | t }}</p>
          {%- endif -%}
          {%- if form.errors -%}
            <div class="customer-form__errors" role="alert">
              <ul>
                {%- for field in form.errors -%}
                  <li>{{ form.errors.messages[field] }}</li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}
          <div class="customer-form__field">
            <label class="visually-hidden" for="RecoverEmail">{{ 'customer.login.email' | t }}</label>
            <input type="email" id="RecoverEmail" name="email" placeholder="{{ 'customer.login.email' | t }}" autocomplete="email" required>
          </div>
          <button type="submit" class="button button--secondary">{{ 'customer.login.recover_submit' | t }}</button>
        {%- endform -%}
      </div>
    </details>
  {%- endform -%}

  <p class="customer-page__footer text-caption">
    {{ 'customer.login.no_account' | t }}
    <a href="{{ routes.account_register_url }}">{{ 'customer.login.create_account' | t }}</a>
  </p>
</div>
