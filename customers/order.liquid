<div class="customer-page page-width">
  <a href="{{ routes.account_url }}" class="customer-page__back text-caption">← {{ 'customer.order.back_to_account' | t }}</a>

  <div class="customer-page__header">
    <div>
      <h1 class="customer-page__title text-heading">{{ 'customer.order.title' | t: name: order.name }}</h1>
      {%- assign order_date = order.created_at | date: '%B %d, %Y' -%}
      <p class="text-caption">{{ 'customer.order.date' | t: date: order_date }}</p>
    </div>
    <div class="order-status-badges">
      <span class="badge badge--custom text-badge">{{ order.financial_status_label }}</span>
      <span class="badge badge--custom text-badge">{{ order.fulfillment_status_label }}</span>
    </div>
  </div>

  <table class="cart-page__table order-detail__table">
    <thead class="visually-hidden">
      <tr>
        <th>{{ 'products.product.details' | t }}</th>
        <th>{{ 'products.product.quantity' | t }}</th>
        <th>{{ 'cart.general.subtotal' | t }}</th>
      </tr>
    </thead>
    <tbody>
      {%- for line_item in order.line_items -%}
        <tr class="cart-page__row">
          <td class="cart-page__row-media">
            {%- render 'responsive-image', image: line_item.image, ratio: 'square', sizes: '120px' -%}
          </td>
          <td class="cart-page__row-details">
            <p class="cart-page__row-title text-body">{{ line_item.title }}</p>
            {%- unless line_item.product.has_only_default_variant -%}
              <p class="cart-page__row-variant text-caption">{{ line_item.variant_title }}</p>
            {%- endunless -%}
          </td>
          <td class="text-body">{{ line_item.quantity }}×</td>
          <td class="cart-page__row-total text-price">{{ line_item.final_line_price | money }}</td>
        </tr>
      {%- endfor -%}
    </tbody>
  </table>

  <div class="order-detail__layout">
    <div class="order-detail__addresses">
      {%- if order.shipping_address -%}
        <div>
          <h2 class="text-heading">{{ 'customer.order.shipping_address' | t }}</h2>
          <p class="text-body">{{ order.shipping_address | format_address }}</p>
        </div>
      {%- endif -%}
      {%- if order.billing_address and order.billing_address != order.shipping_address -%}
        <div>
          <h2 class="text-heading">{{ 'customer.order.billing_address' | t }}</h2>
          <p class="text-body">{{ order.billing_address | format_address }}</p>
        </div>
      {%- endif -%}

      {%- for fulfillment in order.fulfillments -%}
        {%- if fulfillment.tracking_number -%}
          <div>
            <h2 class="text-heading">{{ 'customer.order.tracking_number' | t }}</h2>
            <p class="text-body">{{ fulfillment.tracking_number }}</p>
            {%- if fulfillment.tracking_url -%}
              <a href="{{ fulfillment.tracking_url }}" class="button button--secondary">{{ 'customer.order.track_shipment' | t }}</a>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="order-detail__totals">
      <div class="cart-page__subtotal">
        <span class="text-body">{{ 'customer.order.subtotal' | t }}</span>
        <span class="text-price">{{ order.line_items_subtotal_price | money }}</span>
      </div>
      {%- for shipping_line in order.shipping_lines -%}
        <div class="cart-page__subtotal">
          <span class="text-body">{{ 'customer.order.shipping' | t }}</span>
          <span class="text-price">{{ shipping_line.price | money }}</span>
        </div>
      {%- endfor -%}
      {%- if order.total_discounts > 0 -%}
        <div class="cart-page__subtotal">
          <span class="text-body">{{ 'customer.order.discount' | t }}</span>
          <span class="text-price color-sale">-{{ order.total_discounts | money }}</span>
        </div>
      {%- endif -%}
      {%- for tax_line in order.tax_lines -%}
        <div class="cart-page__subtotal">
          <span class="text-body">{{ 'customer.order.tax' | t }}</span>
          <span class="text-price">{{ tax_line.price | money }}</span>
        </div>
      {%- endfor -%}
      <div class="cart-page__subtotal order-detail__total">
        <span class="text-body">{{ 'customer.order.total' | t }}</span>
        <span class="text-price">{{ order.total_price | money }}</span>
      </div>
    </div>
  </div>
</div>
