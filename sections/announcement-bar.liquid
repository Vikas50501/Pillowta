{%- if section.blocks.size > 0 -%}
  <announcement-bar
    class="announcement-bar color-announcement"
    data-autoplay="{{ section.settings.autoplay }}"
    data-autoplay-speed="{{ section.settings.autoplay_speed | times: 1000 }}"
    {% if section.blocks.size < 2 %}data-single{% endif %}
  >
    <div class="announcement-bar__inner page-width">
      {%- if section.blocks.size > 1 -%}
        <button type="button" class="announcement-bar__arrow announcement-bar__arrow--prev" data-announcement-prev aria-label="{{ 'general.slider.previous' | t }}">
          {%- render 'icon-chevron-left' -%}
        </button>
      {%- endif -%}

      <ul class="announcement-bar__list" data-announcement-list>
        {%- for block in section.blocks -%}
          <li class="announcement-bar__slide{% if forloop.first %} is-active{% endif %}" data-announcement-slide {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}" class="announcement-bar__text text-announcement">{{ block.settings.text }}</a>
            {%- else -%}
              <span class="announcement-bar__text text-announcement">{{ block.settings.text }}</span>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>

      {%- if section.blocks.size > 1 -%}
        <button type="button" class="announcement-bar__arrow announcement-bar__arrow--next" data-announcement-next aria-label="{{ 'general.slider.next' | t }}">
          {%- render 'icon-chevron-right' -%}
        </button>
      {%- endif -%}
    </div>
  </announcement-bar>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "tag": "section",
  "class": "shopify-section--announcement-bar",
  "settings": [
    { "type": "checkbox", "id": "autoplay", "label": "Auto-rotate messages", "default": true },
    { "type": "range", "id": "autoplay_speed", "label": "Change slides every", "min": 3, "max": 10, "step": 1, "unit": "s", "default": 5 }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Message", "default": "Free shipping on orders over $50" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "message" }
    ]
  }
}
{% endschema %}
