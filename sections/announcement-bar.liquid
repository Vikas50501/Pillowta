{%- comment -%}
  Section: Announcement Bar
  Description: A fully responsive, accessible, and customizable announcement bar with sliding capabilities.
{%- endcomment -%}

{%- style -%}
  /* Increased specificity and added display: block for the custom element */
  announcement-slider.announcement-bar-section-{{ section.id }} {
    display: block;
    width: 100%;
    background-color: {{ section.settings.background_color }};
    border-bottom: {{ section.settings.border_bottom_width }}px solid {{ section.settings.border_bottom_color }};
    position: relative;
    z-index: 10;
    
    /* CSS Variables for children */
    --text-color: {{ section.settings.text_color }};
    --font-size: {{ section.settings.font_size }}px;
    --font-weight: {{ section.settings.font_weight }};
    --letter-spacing: {{ section.settings.letter_spacing }}px;
    --padding-top: {{ section.settings.padding_top }}px;
    --padding-bottom: {{ section.settings.padding_bottom }}px;
    --text-alignment: {{ section.settings.text_alignment }};
    --transition-speed: {{ section.settings.transition_speed }}ms;
  }

  .announcement-bar-inner {
    display: flex;
    align-items: center;
    justify-content: var(--text-alignment);
    min-height: 40px;
    padding: var(--padding-top) 1.5rem var(--padding-bottom);
    position: relative;
    overflow: hidden;
  }

  @media screen and (min-width: 750px) {
    .announcement-bar-inner {
      padding-left: 5rem;
      padding-right: 5rem;
    }
  }

  .announcement-bar__slider {
    position: relative;
    width: 100%;
    display: flex;
    justify-content: var(--text-alignment);
    align-items: center;
  }

  .announcement-bar__item {
    width: 100%;
    text-align: var(--text-alignment);
    transition: opacity var(--transition-speed) ease-in-out, transform var(--transition-speed) ease-in-out;
  }

  .announcement-bar__item[aria-hidden="true"] {
    position: absolute;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(10px);
  }

  .announcement-bar__item[aria-hidden="false"] {
    position: relative;
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .announcement-bar__link {
    color: var(--text-color);
    text-decoration: none;
    font-size: var(--font-size);
    font-weight: var(--font-weight);
    letter-spacing: var(--letter-spacing);
    display: inline-block;
    width: 100%;
  }
  
  .announcement-bar__link:hover {
    opacity: 0.8;
  }

  .announcement-bar__message {
    color: var(--text-color);
    font-size: var(--font-size);
    font-weight: var(--font-weight);
    letter-spacing: var(--letter-spacing);
    margin: 0;
    padding: 0;
    line-height: 1.2;
    min-height:0px;
  }
{%- endstyle -%}

<announcement-slider 
  class="announcement-bar-section-{{ section.id }}"
  data-autoplay="{{ section.settings.autoplay }}"
  data-speed="{{ section.settings.autoplay_speed }}"
  role="region" 
  aria-label="{{ 'sections.header.announcement' | t | default: 'Announcement' }}"
>
  {%- if section.blocks.size > 0 -%}
    <div class="announcement-bar-inner">
      <div class="announcement-bar__slider" aria-live="polite">
        {%- for block in section.blocks -%}
          <div 
            class="announcement-bar__item" 
            id="AnnouncementSlide-{{ block.id }}" 
            {{ block.shopify_attributes }}
            aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}"
          >
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}" class="announcement-bar__link">
                <span class="announcement-bar__message">{{ block.settings.text | escape }}</span>
              </a>
            {%- else -%}
              <p class="announcement-bar__message">{{ block.settings.text | escape }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</announcement-slider>

{%- if section.blocks.size > 1 -%}
  <script>
    if (!customElements.get('announcement-slider')) {
      class AnnouncementSlider extends HTMLElement {
        constructor() {
          super();
          this.play = this.play.bind(this);
          this.pause = this.pause.bind(this);
          this.handleBlockSelect = this.handleBlockSelect.bind(this);
          this.handleBlockDeselect = this.handleBlockDeselect.bind(this);
        }

        connectedCallback() {
          this.slides = this.querySelectorAll('.announcement-bar__item');
          this.autoplay = this.dataset.autoplay === 'true';
          this.speed = parseInt(this.dataset.speed) * 1000;
          this.currentIndex = 0;
          
          if (this.slides.length > 1) {
            if (this.autoplay) this.init();
            
            if (Shopify.designMode) {
              document.addEventListener('shopify:block:select', this.handleBlockSelect);
              document.addEventListener('shopify:block:deselect', this.handleBlockDeselect);
            }
          }
        }

        disconnectedCallback() {
          this.pause();
          if (Shopify.designMode) {
            document.removeEventListener('shopify:block:select', this.handleBlockSelect);
            document.removeEventListener('shopify:block:deselect', this.handleBlockDeselect);
          }
        }

        init() {
          this.play();
          
          this.addEventListener('mouseenter', this.pause);
          this.addEventListener('mouseleave', this.play);
          this.addEventListener('focusin', this.pause);
          this.addEventListener('focusout', this.play);
        }

        play() {
          if (!this.autoplay) return;
          this.pause(); 
          this.interval = setInterval(() => this.nextSlide(), this.speed);
        }

        pause() {
          clearInterval(this.interval);
        }

        nextSlide() {
          this.slides[this.currentIndex].setAttribute('aria-hidden', 'true');
          this.currentIndex = (this.currentIndex + 1) % this.slides.length;
          this.slides[this.currentIndex].setAttribute('aria-hidden', 'false');
        }

        goToSlide(index) {
          this.slides.forEach((slide, i) => {
            slide.setAttribute('aria-hidden', i === index ? 'false' : 'true');
          });
          this.currentIndex = index;
        }

        handleBlockSelect(event) {
          if (!this.contains(event.target)) return;
          
          this.pause();
          const blockId = event.detail.blockId;
          const selectedSlideIndex = Array.from(this.slides).findIndex(
            slide => slide.id === `AnnouncementSlide-${blockId}`
          );
          
          if (selectedSlideIndex !== -1) {
            this.goToSlide(selectedSlideIndex);
          }
        }

        handleBlockDeselect(event) {
          if (!this.contains(event.target)) return;
          this.play();
        }
      }
      
      customElements.define('announcement-slider', AnnouncementSlider);
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Announcement Bar",
  "max_blocks": 5,
  "settings": [
    {
      "type": "header",
      "content": "Appearance (Matches Reference)"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#EBE0E7"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#17435C"
    },
    {
      "type": "color",
      "id": "border_bottom_color",
      "label": "Bottom Border Color",
      "default": "#7A9CA0"
    },
    {
      "type": "range",
      "id": "border_bottom_width",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "px",
      "label": "Bottom Border Width",
      "default": 3
    },
    {
      "type": "header",
      "content": "Typography & Layout"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text Alignment",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Right" }
      ],
      "default": "flex-end"
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Font Size",
      "default": 14
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font Weight",
      "options": [
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi-Bold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "400"
    },
    {
      "type": "range",
      "id": "letter_spacing",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "unit": "px",
      "label": "Letter Spacing",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Top Padding",
      "default": 10
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 10
    },
    {
      "type": "header",
      "content": "Slider Settings"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto-rotate announcements",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 2,
      "max": 10,
      "step": 1,
      "unit": "sec",
      "label": "Rotation Speed",
      "default": 5
    },
    {
      "type": "range",
      "id": "transition_speed",
      "min": 200,
      "max": 1000,
      "step": 100,
      "unit": "ms",
      "label": "Transition Speed",
      "default": 400
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "enjoy our great international shipping rates"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Optional"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement Bar",
      "blocks": [
        {
          "type": "announcement"
        }
      ]
    }
  ]
}
{% endschema %}