{%- liquid
  assign section_width_class = ''
  unless section.settings.section_width == 'full'
    assign section_width_class = 'page-width'
  endunless
  assign featured_article = section.settings.article
  assign excerpt_source = featured_article.excerpt
  if excerpt_source == blank
    assign excerpt_source = featured_article.content
  endif
  assign excerpt_text = excerpt_source | strip_html | truncate: 200
-%}
<div
  class="featured-article section-padding{% if section.settings.hide_on_mobile %} rich-text--hide-mobile{% endif %}{% if section.settings.hide_on_desktop %} rich-text--hide-desktop{% endif %}"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="{{ section_width_class }}">
    {%- if featured_article != blank -%}
      <div class="featured-article__inner"{% if section.settings.animation != 'none' %} data-scroll-reveal="{{ section.settings.animation }}"{% endif %}>
        <a href="{{ featured_article.url }}" class="featured-article__media hover-target hover-target--media" aria-label="{{ featured_article.title | escape }}">
          {%- render 'responsive-image', image: featured_article.image, ratio: 'landscape', sizes: '(min-width: 750px) 50vw, 100vw', placeholder: 'lifestyle-1' -%}
        </a>

        <div class="featured-article__content">
          {%- if featured_article.tags.size > 0 -%}
            <div class="featured-article__tags">
              {%- for tag in featured_article.tags limit: 3 -%}
                <span class="featured-article__tag text-caption">{{ tag }}</span>
              {%- endfor -%}
            </div>
          {%- endif -%}

          <h2 class="featured-article__heading text-heading">{{ featured_article.title }}</h2>

          <p class="featured-article__meta text-caption">
            {%- if featured_article.author != blank -%}
              {{ 'blog.article.by_author' | t: author: featured_article.author }}
              <span class="featured-article__meta-separator">·</span>
            {%- endif -%}
            {{ featured_article.published_at | date: '%B %d, %Y' }}
          </p>

          {%- if excerpt_text != blank -%}
            <p class="featured-article__excerpt text-blog">{{ excerpt_text }}</p>
          {%- endif -%}

          <a href="{{ featured_article.url }}" class="button button--primary featured-article__button">
            {{ 'blog.article.read_more' | t }}
          </a>
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Featured article",
  "tag": "section",
  "class": "shopify-section--featured-article",
  "settings": [
    { "type": "blog", "id": "blog", "label": "Blog" },
    { "type": "article", "id": "article", "label": "Article" },

    { "type": "header", "content": "Section" },
    { "type": "select", "id": "section_width", "label": "Width", "default": "full",
      "options": [
        { "value": "full", "label": "Full width" },
        { "value": "wide", "label": "Wide" },
        { "value": "contained", "label": "Contained" }
      ]
    },
    { "type": "select", "id": "animation", "label": "Entrance animation", "default": "fade",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "fade", "label": "Fade" },
        { "value": "slide-up", "label": "Slide up" },
        { "value": "scale", "label": "Scale" }
      ]
    },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 },
    { "type": "checkbox", "id": "hide_on_mobile", "label": "Hide on mobile", "default": false },
    { "type": "checkbox", "id": "hide_on_desktop", "label": "Hide on desktop", "default": false }
  ],
  "presets": [
    { "name": "Featured article" }
  ]
}
{% endschema %}
