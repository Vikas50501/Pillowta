{%- liquid
  assign section_width_class = 'page-width'
  if section.settings.section_width == 'full'
    assign section_width_class = ''
  endif
  assign reveal = section.settings.animation
-%}
<div
  class="brand-logos{% if section.settings.hide_on_mobile %} brand-logos--hide-mobile{% endif %}{% if section.settings.hide_on_desktop %} brand-logos--hide-desktop{% endif %}"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
  data-hide-mobile="{{ section.settings.hide_on_mobile }}"
  data-hide-desktop="{{ section.settings.hide_on_desktop }}"
>
  <div class="{{ section_width_class }}">
    {%- if section.settings.heading != blank -%}
      <h2 class="brand-logos__heading text-heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.enable_marquee -%}
      <div class="brand-logos__marquee marquee"{% if reveal != 'none' %} data-scroll-reveal="{{ reveal }}"{% endif %}>
        <div class="brand-logos__track marquee__track" style="--marquee-duration: {{ section.settings.marquee_speed }}s;">
          {%- for i in (1..2) -%}
            {%- for block in section.blocks -%}
              <div class="brand-logos__item" {% if i == 1 %}{{ block.shopify_attributes }}{% endif %} aria-hidden="{% if i == 2 %}true{% else %}false{% endif %}">
                {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" class="brand-logos__link">{%- endif -%}
                {%- render 'responsive-image', image: block.settings.logo, ratio: 'natural', sizes: '160px' -%}
                {%- if block.settings.link != blank -%}</a>{%- endif -%}
              </div>
            {%- endfor -%}
          {%- endfor -%}
        </div>
      </div>
    {%- else -%}
      <div class="brand-logos__row"{% if reveal != 'none' %} data-scroll-reveal="{{ reveal }}"{% endif %}>
        {%- for block in section.blocks -%}
          <div class="brand-logos__item" {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" class="brand-logos__link">{%- endif -%}
            {%- render 'responsive-image', image: block.settings.logo, ratio: 'natural', sizes: '160px' -%}
            {%- if block.settings.link != blank -%}</a>{%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Brand logos",
  "tag": "section",
  "class": "shopify-section--brand-logos",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "As seen in" },
    { "type": "checkbox", "id": "enable_marquee", "label": "Enable auto-scrolling marquee", "default": false },
    { "type": "range", "id": "marquee_speed", "label": "Marquee speed", "min": 10, "max": 60, "step": 1, "unit": "s", "default": 30, "info": "Only applies when the marquee is enabled. Lower is faster." },

    { "type": "header", "content": "Section" },
    { "type": "select", "id": "animation", "label": "Entrance animation", "default": "fade",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "fade", "label": "Fade" },
        { "value": "slide-up", "label": "Slide up" },
        { "value": "scale", "label": "Scale" }
      ]
    },
    { "type": "select", "id": "section_width", "label": "Width", "default": "full",
      "options": [
        { "value": "full", "label": "Full width" },
        { "value": "wide", "label": "Wide" },
        { "value": "contained", "label": "Contained" }
      ]
    },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 48 },
    { "type": "checkbox", "id": "hide_on_mobile", "label": "Hide on mobile", "default": false },
    { "type": "checkbox", "id": "hide_on_desktop", "label": "Hide on desktop", "default": false }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        { "type": "image_picker", "id": "logo", "label": "Logo" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brand logos",
      "blocks": [
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" }
      ]
    }
  ]
}
{% endschema %}
