{%- liquid
  assign section_width_class = 'page-width'
  if section.settings.section_width == 'full'
    assign section_width_class = ''
  endif
  assign reveal = section.settings.animation
-%}
<div
  class="before-after-section{% if section.settings.hide_on_mobile %} before-after-section--hide-mobile{% endif %}{% if section.settings.hide_on_desktop %} before-after-section--hide-desktop{% endif %}"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
  data-hide-mobile="{{ section.settings.hide_on_mobile }}"
  data-hide-desktop="{{ section.settings.hide_on_desktop }}"
>
  <div class="{{ section_width_class }}">
    {%- if section.settings.heading != blank -%}
      <h2 class="before-after-section__heading text-heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="before-after" data-before-after{% if reveal != 'none' %} data-scroll-reveal="{{ reveal }}"{% endif %}>
      <div class="before-after__frame">
        <div class="before-after__image before-after__image--before">
          {%- render 'responsive-image', image: section.settings.image_before, ratio: 'square', sizes: '(min-width: 750px) 700px, 100vw' -%}
          <span class="before-after__label before-after__label--before text-caption">{{ section.settings.label_before }}</span>
        </div>
        <div class="before-after__image before-after__image--after" data-before-after-after>
          {%- render 'responsive-image', image: section.settings.image_after, ratio: 'square', sizes: '(min-width: 750px) 700px, 100vw' -%}
          <span class="before-after__label before-after__label--after text-caption">{{ section.settings.label_after }}</span>
        </div>
        <button
          type="button"
          class="before-after__handle"
          data-before-after-handle
          role="slider"
          aria-label="Drag to compare before and after"
          aria-valuemin="0"
          aria-valuemax="100"
          aria-valuenow="50"
          tabindex="0"
        >
          <span class="before-after__handle-icon" aria-hidden="true">
            {%- render 'icon-chevron-left', size: 14 -%}
            {%- render 'icon-chevron-right', size: 14 -%}
          </span>
        </button>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Before / after",
  "tag": "section",
  "class": "shopify-section--before-after",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "See the difference" },
    { "type": "image_picker", "id": "image_before", "label": "Before image" },
    { "type": "image_picker", "id": "image_after", "label": "After image" },
    { "type": "text", "id": "label_before", "label": "Before label", "default": "Before" },
    { "type": "text", "id": "label_after", "label": "After label", "default": "After" },

    { "type": "header", "content": "Section" },
    { "type": "select", "id": "animation", "label": "Entrance animation", "default": "fade",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "fade", "label": "Fade" },
        { "value": "slide-up", "label": "Slide up" },
        { "value": "scale", "label": "Scale" }
      ]
    },
    { "type": "select", "id": "section_width", "label": "Width", "default": "full",
      "options": [
        { "value": "full", "label": "Full width" },
        { "value": "wide", "label": "Wide" },
        { "value": "contained", "label": "Contained" }
      ]
    },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 },
    { "type": "checkbox", "id": "hide_on_mobile", "label": "Hide on mobile", "default": false },
    { "type": "checkbox", "id": "hide_on_desktop", "label": "Hide on desktop", "default": false }
  ],
  "presets": [
    {
      "name": "Before / after"
    }
  ]
}
{% endschema %}
