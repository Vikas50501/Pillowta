{%- liquid
  assign section_width_class = 'page-width'
  if section.settings.section_width == 'full'
    assign section_width_class = ''
  elsif section.settings.section_width == 'wide'
    assign section_width_class = 'page-width'
  endif
  assign reveal = section.settings.animation
-%}
<div
  class="hero-banner hero-banner--{{ section.settings.height }}{% if section.settings.hide_on_mobile %} hero-banner--hide-mobile{% endif %}{% if section.settings.hide_on_desktop %} hero-banner--hide-desktop{% endif %}"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
  data-hide-mobile="{{ section.settings.hide_on_mobile }}"
  data-hide-desktop="{{ section.settings.hide_on_desktop }}"
>
  <div class="hero-banner__media">
    {%- if section.settings.image != blank -%}
      <picture>
        {%- if section.settings.image_mobile != blank -%}
          <source media="(max-width: 749px)" srcset="{{ section.settings.image_mobile | image_url: width: 1000 }}">
        {%- endif -%}
        <img
          src="{{ section.settings.image | image_url: width: 1800 }}"
          srcset="{% render 'image-srcset', image: section.settings.image %}"
          sizes="100vw"
          alt="{{ section.settings.image.alt | escape }}"
          width="{{ section.settings.image.width }}"
          height="{{ section.settings.image.height }}"
          loading="{% if section.index == 1 %}eager{% else %}lazy{% endif %}"
          class="hero-banner__image"
        >
      </picture>
    {%- else -%}
      <div class="hero-banner__image hero-banner__image--placeholder"></div>
    {%- endif -%}
    {%- if section.settings.overlay_opacity > 0 -%}
      <div class="hero-banner__overlay" style="opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"></div>
    {%- endif -%}
  </div>

  <div class="hero-banner__content hero-banner__content--{{ section.settings.content_position }} {{ section_width_class }}">
    <div class="hero-banner__content-inner"{% if reveal != 'none' %} data-scroll-reveal="{{ reveal }}"{% endif %}>
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'heading' -%}
            <h2 class="hero-banner__heading text-heading" {{ block.shopify_attributes }}>{{ block.settings.heading }}</h2>
          {%- when 'text' -%}
            <div class="hero-banner__text text-body" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
          {%- when 'button' -%}
            <a
              href="{{ block.settings.link | default: '#' }}"
              class="button button--{{ block.settings.style }} hero-banner__button"
              {{ block.shopify_attributes }}
            >
              {{ block.settings.label }}
            </a>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Hero banner",
  "tag": "section",
  "class": "shopify-section--hero-banner",
  "settings": [
    { "type": "header", "content": "Media" },
    { "type": "image_picker", "id": "image", "label": "Image (desktop)" },
    { "type": "image_picker", "id": "image_mobile", "label": "Image (mobile)" },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 20 },
    { "type": "select", "id": "height", "label": "Height", "default": "large",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" },
        { "value": "full", "label": "Full screen" }
      ]
    },

    { "type": "header", "content": "Content" },
    { "type": "select", "id": "content_position", "label": "Content position", "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    { "type": "select", "id": "animation", "label": "Entrance animation", "default": "fade",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "fade", "label": "Fade" },
        { "value": "slide-up", "label": "Slide up" },
        { "value": "scale", "label": "Scale" }
      ]
    },

    { "type": "header", "content": "Section" },
    { "type": "select", "id": "section_width", "label": "Width", "default": "full",
      "options": [
        { "value": "full", "label": "Full width" },
        { "value": "wide", "label": "Wide" },
        { "value": "contained", "label": "Contained" }
      ]
    },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 0 },
    { "type": "checkbox", "id": "hide_on_mobile", "label": "Hide on mobile", "default": false },
    { "type": "checkbox", "id": "hide_on_desktop", "label": "Hide on desktop", "default": false }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Heading",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Beauty, reimagined" }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Clean, high-performance formulas made for real life.</p>" }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Shop now" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "select", "id": "style", "label": "Style", "default": "primary",
          "options": [
            { "value": "primary", "label": "Primary" },
            { "value": "secondary", "label": "Secondary" }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero banner",
      "blocks": [
        { "type": "heading" },
        { "type": "text" },
        { "type": "button" }
      ]
    }
  ]
}
{% endschema %}
