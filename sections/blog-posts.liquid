{%- liquid
  assign section_width_class = ''
  unless section.settings.section_width == 'full'
    assign section_width_class = 'page-width'
  endunless
-%}
<div
  class="blog-posts section-padding{% if section.settings.hide_on_mobile %} rich-text--hide-mobile{% endif %}{% if section.settings.hide_on_desktop %} rich-text--hide-desktop{% endif %}"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="{{ section_width_class }}">
    <div class="blog-posts__header"{% if section.settings.animation != 'none' %} data-scroll-reveal="{{ section.settings.animation }}"{% endif %}>
      {%- if section.settings.heading != blank -%}
        <h2 class="blog-posts__heading text-heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.show_view_all and section.settings.blog != blank -%}
        <a href="{{ section.settings.blog.url }}" class="blog-posts__view-all text-navigation hover-target--text">
          {{ 'collection.view_all' | t }}
        </a>
      {%- endif -%}
    </div>

    {%- if section.settings.blog != blank -%}
      <ul class="blog-posts__grid" style="--columns-desktop: {{ section.settings.columns_desktop }};">
        {%- for article in section.settings.blog.articles limit: section.settings.posts_to_show -%}
          <li data-scroll-reveal="{{ section.settings.animation }}" data-scroll-reveal-delay="{{ forloop.index0 | times: 60 }}">
            {%- render 'article-card', article: article -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Blog posts",
  "tag": "section",
  "class": "shopify-section--blog-posts",
  "settings": [
    { "type": "blog", "id": "blog", "label": "Blog" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "From the journal" },
    { "type": "range", "id": "posts_to_show", "label": "Posts to show", "min": 2, "max": 12, "step": 1, "default": 3 },
    { "type": "range", "id": "columns_desktop", "label": "Columns (desktop)", "min": 2, "max": 4, "step": 1, "default": 3 },
    { "type": "checkbox", "id": "show_view_all", "label": "Show \"view all\" link", "default": true },

    { "type": "header", "content": "Section" },
    { "type": "select", "id": "section_width", "label": "Width", "default": "full",
      "options": [
        { "value": "full", "label": "Full width" },
        { "value": "wide", "label": "Wide" },
        { "value": "contained", "label": "Contained" }
      ]
    },
    { "type": "select", "id": "animation", "label": "Entrance animation", "default": "fade",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "fade", "label": "Fade" },
        { "value": "slide-up", "label": "Slide up" },
        { "value": "scale", "label": "Scale" }
      ]
    },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 },
    { "type": "checkbox", "id": "hide_on_mobile", "label": "Hide on mobile", "default": false },
    { "type": "checkbox", "id": "hide_on_desktop", "label": "Hide on desktop", "default": false }
  ],
  "presets": [
    { "name": "Blog posts" }
  ]
}
{% endschema %}
