{%- liquid
  assign section_width_class = 'page-width'
  if section.settings.section_width == 'full'
    assign section_width_class = ''
  endif
  assign reveal = section.settings.animation
  assign text_class = 'text-heading'
  if section.settings.text_size == 'caption'
    assign text_class = 'text-caption'
  endif
-%}
<div
  class="marquee-section{% if section.settings.hide_on_mobile %} marquee-section--hide-mobile{% endif %}{% if section.settings.hide_on_desktop %} marquee-section--hide-desktop{% endif %}"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
  data-hide-mobile="{{ section.settings.hide_on_mobile }}"
  data-hide-desktop="{{ section.settings.hide_on_desktop }}"
>
  <div class="{{ section_width_class }}">
    <div class="marquee-section__marquee marquee"{% if reveal != 'none' %} data-scroll-reveal="{{ reveal }}"{% endif %}>
      <div class="marquee-section__track marquee__track" style="--marquee-duration: {{ section.settings.marquee_speed }}s;">
        {%- for i in (1..2) -%}
          {%- for block in section.blocks -%}
            <span class="marquee-section__item {{ text_class }}" {% if i == 1 %}{{ block.shopify_attributes }}{% endif %} aria-hidden="{% if i == 2 %}true{% else %}false{% endif %}">
              {{ block.settings.text }}
            </span>
          {%- endfor -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Marquee",
  "tag": "section",
  "class": "shopify-section--marquee",
  "settings": [
    { "type": "select", "id": "text_size", "label": "Text size", "default": "heading",
      "options": [
        { "value": "heading", "label": "Heading" },
        { "value": "caption", "label": "Caption" }
      ]
    },
    { "type": "range", "id": "marquee_speed", "label": "Marquee speed", "min": 10, "max": 60, "step": 1, "unit": "s", "default": 20, "info": "Lower is faster." },

    { "type": "header", "content": "Section" },
    { "type": "select", "id": "animation", "label": "Entrance animation", "default": "fade",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "fade", "label": "Fade" },
        { "value": "slide-up", "label": "Slide up" },
        { "value": "scale", "label": "Scale" }
      ]
    },
    { "type": "select", "id": "section_width", "label": "Width", "default": "full",
      "options": [
        { "value": "full", "label": "Full width" },
        { "value": "wide", "label": "Wide" },
        { "value": "contained", "label": "Contained" }
      ]
    },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 32 },
    { "type": "checkbox", "id": "hide_on_mobile", "label": "Hide on mobile", "default": false },
    { "type": "checkbox", "id": "hide_on_desktop", "label": "Hide on desktop", "default": false }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Text item",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Free shipping over $50" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Marquee",
      "blocks": [
        { "type": "text", "settings": { "text": "Free shipping over $50" } },
        { "type": "text", "settings": { "text": "Cruelty-free & vegan" } },
        { "type": "text", "settings": { "text": "30-day returns" } }
      ]
    }
  ]
}
{% endschema %}
