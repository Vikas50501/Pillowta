{%- liquid
  assign section_width_class = 'page-width'
  if section.settings.section_width == 'full'
    assign section_width_class = ''
  endif
  assign reveal = section.settings.animation
-%}
<div
  class="faq-accordion{% if section.settings.hide_on_mobile %} faq-accordion--hide-mobile{% endif %}{% if section.settings.hide_on_desktop %} faq-accordion--hide-desktop{% endif %}"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
  data-hide-mobile="{{ section.settings.hide_on_mobile }}"
  data-hide-desktop="{{ section.settings.hide_on_desktop }}"
>
  <div class="{{ section_width_class }} page-width--narrow">
    <div class="faq-accordion__inner"{% if reveal != 'none' %} data-scroll-reveal="{{ reveal }}"{% endif %}>
      {%- if section.settings.heading != blank -%}
        <h2 class="faq-accordion__heading text-heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      <div class="faq-accordion__list">
        {%- for block in section.blocks -%}
          {%- assign unique_id = section.id | append: '-' | append: block.id -%}
          <div class="faq-accordion__item" {{ block.shopify_attributes }}>
            <button
              type="button"
              class="faq-accordion__trigger accordion__trigger text-body"
              data-accordion-trigger
              aria-expanded="false"
              aria-controls="{{ unique_id }}"
            >
              <span>{{ block.settings.question }}</span>
              {%- render 'icon-chevron-down', size: 18 -%}
            </button>
            <div id="{{ unique_id }}" class="faq-accordion__content accordion__content">
              <div class="faq-accordion__answer text-body">{{ block.settings.answer }}</div>
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "FAQ",
  "tag": "section",
  "class": "shopify-section--faq-accordion",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently asked questions" },

    { "type": "header", "content": "Section" },
    { "type": "select", "id": "animation", "label": "Entrance animation", "default": "fade",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "fade", "label": "Fade" },
        { "value": "slide-up", "label": "Slide up" },
        { "value": "scale", "label": "Scale" }
      ]
    },
    { "type": "select", "id": "section_width", "label": "Width", "default": "full",
      "options": [
        { "value": "full", "label": "Full width" },
        { "value": "wide", "label": "Wide" },
        { "value": "contained", "label": "Contained" }
      ]
    },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 },
    { "type": "checkbox", "id": "hide_on_mobile", "label": "Hide on mobile", "default": false },
    { "type": "checkbox", "id": "hide_on_desktop", "label": "Hide on desktop", "default": false }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How long does shipping take?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Most orders arrive within 3-5 business days.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "question" },
        { "type": "question" },
        { "type": "question" }
      ]
    }
  ]
}
{% endschema %}
