{%- comment -%}
  Site-wide promotional popup. Self-contained, always in the DOM but hidden
  by default (aria-hidden="true", .is-open toggled by assets/popup.js).
  Intended to be included once in layout/theme.liquid by another process.
{%- endcomment -%}
<promo-popup
  class="popup color-popup"
  id="PromoPopup"
  aria-hidden="true"
  data-popup-enabled="{{ section.settings.enabled }}"
  data-popup-type="{{ section.settings.popup_type }}"
  data-popup-trigger="{{ section.settings.trigger }}"
  data-popup-delay="{{ section.settings.delay_seconds }}"
  data-popup-frequency="{{ section.settings.frequency }}"
>
  <div class="popup__overlay" data-popup-close></div>
  <div class="popup__panel" role="dialog" aria-modal="true" aria-label="{{ section.settings.heading | default: shop.name | escape }}">
    <button type="button" class="popup__close" data-popup-close aria-label="{{ 'general.accessibility.close' | t }}">
      {%- render 'icon-close' -%}
    </button>

    {%- if section.settings.image != blank -%}
      <div class="popup__media">
        {%- render 'responsive-image', image: section.settings.image, ratio: 'square', sizes: '(min-width: 750px) 400px, 100vw' -%}
      </div>
    {%- endif -%}

    <div class="popup__content">
      {%- if section.settings.heading != blank -%}
        <h2 class="popup__heading text-heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.body != blank -%}
        <div class="popup__body rte text-body">{{ section.settings.body }}</div>
      {%- endif -%}

      {%- if section.settings.popup_type == 'newsletter' -%}
        {%- form 'customer', class: 'popup__form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <label class="visually-hidden" for="PopupNewsletterEmail">{{ 'footer.newsletter.placeholder' | t }}</label>
          <input
            type="email"
            name="contact[email]"
            id="PopupNewsletterEmail"
            class="popup__form-input"
            placeholder="{{ 'footer.newsletter.placeholder' | t }}"
            required
          >
          <button type="submit" class="button button--primary popup__form-submit">
            {{ 'blog.popup.newsletter_submit' | t }}
          </button>
          {%- if form.posted_successfully? -%}
            <p class="popup__form-success text-caption">{{ 'footer.newsletter.success' | t }}</p>
          {%- endif -%}
        {%- endform -%}
      {%- else -%}
        {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
          <a href="{{ section.settings.button_link }}" class="button button--primary popup__button">
            {{ section.settings.button_label }}
          </a>
        {%- endif -%}
      {%- endif -%}
    </div>
  </div>
</promo-popup>

{% schema %}
{
  "name": "Promotional popup",
  "tag": "section",
  "class": "shopify-section--popup",
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "Enable popup", "default": false },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get 10% off your first order" },
    { "type": "richtext", "id": "body", "label": "Body text", "default": "<p>Sign up for our newsletter and be the first to know about new arrivals and exclusive offers.</p>" },
    { "type": "image_picker", "id": "image", "label": "Image" },

    { "type": "header", "content": "Call to action" },
    { "type": "select", "id": "popup_type", "label": "Popup type", "default": "newsletter",
      "options": [
        { "value": "newsletter", "label": "Newsletter signup" },
        { "value": "custom_link", "label": "Button and link" }
      ]
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now", "info": "Used when popup type is \"Button and link\"." },
    { "type": "url", "id": "button_link", "label": "Button link" },

    { "type": "header", "content": "Behavior" },
    { "type": "select", "id": "trigger", "label": "Trigger", "default": "delay",
      "options": [
        { "value": "delay", "label": "After a delay" },
        { "value": "exit_intent", "label": "On exit intent" }
      ]
    },
    { "type": "range", "id": "delay_seconds", "label": "Delay (seconds)", "min": 1, "max": 60, "step": 1, "default": 5, "info": "Only used when trigger is \"After a delay\"." },
    { "type": "select", "id": "frequency", "label": "Show frequency", "default": "once_per_day",
      "options": [
        { "value": "every_visit", "label": "Every visit" },
        { "value": "once_per_session", "label": "Once per session" },
        { "value": "once_per_day", "label": "Once per day" }
      ]
    }
  ]
}
{% endschema %}
