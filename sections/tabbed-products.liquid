{%- liquid
  assign section_width_class = 'page-width'
  if section.settings.section_width == 'full'
    assign section_width_class = ''
  endif
  assign reveal = section.settings.animation
-%}
<div
  class="tabbed-products{% if section.settings.hide_on_mobile %} tabbed-products--hide-mobile{% endif %}{% if section.settings.hide_on_desktop %} tabbed-products--hide-desktop{% endif %}"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
  data-hide-mobile="{{ section.settings.hide_on_mobile }}"
  data-hide-desktop="{{ section.settings.hide_on_desktop }}"
>
  <div class="{{ section_width_class }}">
    <div class="tabbed-products__inner"{% if reveal != 'none' %} data-scroll-reveal="{{ reveal }}"{% endif %}>
      {%- if section.settings.heading != blank -%}
        <h2 class="tabbed-products__heading text-heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="tabbed-products__tabs" role="tablist">
          {%- for block in section.blocks -%}
            <button
              type="button"
              class="tabbed-products__tab text-button{% if forloop.first %} is-active{% endif %}"
              data-tab-trigger
              data-tab-target="tab-{{ block.id }}"
              role="tab"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              {{ block.shopify_attributes }}
            >
              {{ block.settings.title }}
            </button>
          {%- endfor -%}
        </div>

        {%- for block in section.blocks -%}
          <div
            id="tab-{{ block.id }}"
            class="tabbed-products__panel{% if forloop.first %} is-active{% endif %}"
            role="tabpanel"
            {% unless forloop.first %}hidden{% endunless %}
          >
            <ul class="tabbed-products__grid">
              {%- if block.settings.collection != blank -%}
                {%- for product in block.settings.collection.products limit: 8 -%}
                  <li class="tabbed-products__card">
                    <a href="{{ product.url }}" class="tabbed-products__card-link">
                      <div class="tabbed-products__image">
                        {%- render 'responsive-image', image: product.featured_image, ratio: 'square', sizes: '(min-width: 990px) 25vw, 50vw' -%}
                      </div>
                      <p class="tabbed-products__title text-body">{{ product.title }}</p>
                      <p class="tabbed-products__price text-price">{{ product.price | money }}</p>
                    </a>
                  </li>
                {%- endfor -%}
              {%- endif -%}
            </ul>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Tabbed products",
  "tag": "section",
  "class": "shopify-section--tabbed-products",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by category" },

    { "type": "header", "content": "Section" },
    { "type": "select", "id": "animation", "label": "Entrance animation", "default": "fade",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "fade", "label": "Fade" },
        { "value": "slide-up", "label": "Slide up" },
        { "value": "scale", "label": "Scale" }
      ]
    },
    { "type": "select", "id": "section_width", "label": "Width", "default": "full",
      "options": [
        { "value": "full", "label": "Full width" },
        { "value": "wide", "label": "Wide" },
        { "value": "contained", "label": "Contained" }
      ]
    },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 },
    { "type": "checkbox", "id": "hide_on_mobile", "label": "Hide on mobile", "default": false },
    { "type": "checkbox", "id": "hide_on_desktop", "label": "Hide on desktop", "default": false }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        { "type": "text", "id": "title", "label": "Tab title", "default": "Best sellers" },
        { "type": "collection", "id": "collection", "label": "Collection" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Tabbed products",
      "blocks": [
        { "type": "tab" },
        { "type": "tab" }
      ]
    }
  ]
}
{% endschema %}
