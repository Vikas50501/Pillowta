{%- liquid
  assign section_width_class = 'page-width'
  if section.settings.section_width == 'full'
    assign section_width_class = ''
  endif
  assign reveal = section.settings.animation
-%}
<div
  class="newsletter-section{% if section.settings.background_image != blank %} newsletter-section--has-image{% endif %}{% if section.settings.hide_on_mobile %} newsletter-section--hide-mobile{% endif %}{% if section.settings.hide_on_desktop %} newsletter-section--hide-desktop{% endif %}"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
  data-hide-mobile="{{ section.settings.hide_on_mobile }}"
  data-hide-desktop="{{ section.settings.hide_on_desktop }}"
>
  {%- if section.settings.background_image != blank -%}
    <div class="newsletter-section__background">
      {%- render 'responsive-image', image: section.settings.background_image, ratio: 'landscape', sizes: '100vw' -%}
    </div>
  {%- endif -%}

  <div class="{{ section_width_class }}">
    <div class="newsletter-section__inner"{% if reveal != 'none' %} data-scroll-reveal="{{ reveal }}"{% endif %}>
      {%- if section.settings.heading != blank -%}
        <h2 class="newsletter-section__heading text-heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <div class="newsletter-section__subheading text-body">{{ section.settings.subheading }}</div>
      {%- endif -%}

      {%- form 'customer', class: 'newsletter-section__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <label class="visually-hidden" for="NewsletterEmail-{{ section.id }}">Email address</label>
        <input
          type="email"
          name="contact[email]"
          id="NewsletterEmail-{{ section.id }}"
          class="newsletter-section__input"
          placeholder="Enter your email"
          autocomplete="email"
          required
        >
        <button type="submit" class="button button--primary newsletter-section__submit">
          Sign up
        </button>
        {%- if form.posted_successfully? -%}
          <p class="newsletter-section__success text-caption">Thanks for signing up.</p>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Newsletter",
  "tag": "section",
  "class": "shopify-section--newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Join the list" },
    { "type": "richtext", "id": "subheading", "label": "Subheading", "default": "<p>Sign up for early access to new drops and exclusive offers.</p>" },
    { "type": "image_picker", "id": "background_image", "label": "Background image" },

    { "type": "header", "content": "Section" },
    { "type": "select", "id": "animation", "label": "Entrance animation", "default": "fade",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "fade", "label": "Fade" },
        { "value": "slide-up", "label": "Slide up" },
        { "value": "scale", "label": "Scale" }
      ]
    },
    { "type": "select", "id": "section_width", "label": "Width", "default": "full",
      "options": [
        { "value": "full", "label": "Full width" },
        { "value": "wide", "label": "Wide" },
        { "value": "contained", "label": "Contained" }
      ]
    },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 },
    { "type": "checkbox", "id": "hide_on_mobile", "label": "Hide on mobile", "default": false },
    { "type": "checkbox", "id": "hide_on_desktop", "label": "Hide on desktop", "default": false }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}
