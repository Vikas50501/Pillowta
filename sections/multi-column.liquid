{%- liquid
  assign section_width_class = 'page-width'
  if section.settings.section_width == 'full'
    assign section_width_class = ''
  endif
  assign reveal = section.settings.animation
-%}
<div
  class="multi-column{% if section.settings.hide_on_mobile %} multi-column--hide-mobile{% endif %}{% if section.settings.hide_on_desktop %} multi-column--hide-desktop{% endif %}"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
  data-hide-mobile="{{ section.settings.hide_on_mobile }}"
  data-hide-desktop="{{ section.settings.hide_on_desktop }}"
>
  <div class="{{ section_width_class }}">
    {%- if section.settings.heading != blank -%}
      <h2 class="multi-column__heading text-heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    <div class="multi-column__grid" style="--multi-column-cols: {{ section.settings.columns }};">
      {%- for block in section.blocks -%}
        <div
          class="multi-column__item"
          {% if reveal != 'none' %}data-scroll-reveal="{{ reveal }}"{% endif %}
          {% if section.settings.stagger_animation %}data-scroll-reveal-delay="{{ forloop.index0 | times: 100 }}"{% endif %}
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.icon != blank -%}
            <div class="multi-column__icon">
              {%- render 'responsive-image', image: block.settings.icon, ratio: 'square', sizes: '80px' -%}
            </div>
          {%- endif -%}
          {%- if block.settings.heading != blank -%}
            <h3 class="multi-column__item-heading text-heading">{{ block.settings.heading }}</h3>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <div class="multi-column__text text-body">{{ block.settings.text }}</div>
          {%- endif -%}
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}" class="multi-column__link text-button">
              {{ block.settings.link_label | default: 'Learn more' }}
            </a>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Multi-column",
  "tag": "section",
  "class": "shopify-section--multi-column",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why shop with us" },
    { "type": "select", "id": "columns", "label": "Columns", "default": "3",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ]
    },
    { "type": "checkbox", "id": "stagger_animation", "label": "Stagger column animation", "default": true },

    { "type": "header", "content": "Section" },
    { "type": "select", "id": "animation", "label": "Entrance animation", "default": "fade",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "fade", "label": "Fade" },
        { "value": "slide-up", "label": "Slide up" },
        { "value": "scale", "label": "Scale" }
      ]
    },
    { "type": "select", "id": "section_width", "label": "Width", "default": "full",
      "options": [
        { "value": "full", "label": "Full width" },
        { "value": "wide", "label": "Wide" },
        { "value": "contained", "label": "Contained" }
      ]
    },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 },
    { "type": "checkbox", "id": "hide_on_mobile", "label": "Hide on mobile", "default": false },
    { "type": "checkbox", "id": "hide_on_desktop", "label": "Hide on desktop", "default": false }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        { "type": "image_picker", "id": "icon", "label": "Icon or image" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Cruelty-free" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Never tested on animals, always tested on real skin.</p>" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "Learn more" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Multi-column",
      "blocks": [
        { "type": "column" },
        { "type": "column" },
        { "type": "column" }
      ]
    }
  ]
}
{% endschema %}
