<cart-drawer class="cart-drawer color-drawer" id="CartDrawer" aria-hidden="true">
  <div class="cart-drawer__overlay" data-cart-close></div>
  <div class="cart-drawer__panel" role="dialog" aria-modal="true" aria-label="{{ 'cart.general.title' | t }}">
    <header class="cart-drawer__header">
      <h2 class="cart-drawer__title text-heading">{{ 'cart.general.title' | t }}</h2>
      <button type="button" class="cart-drawer__close" data-cart-close aria-label="{{ 'general.accessibility.close_cart' | t }}">
        {%- render 'icon-close' -%}
      </button>
    </header>

    {%- if cart.item_count > 0 -%}
      {%- liquid
        assign free_shipping_threshold = 5000
        assign remaining = free_shipping_threshold | minus: cart.total_price
        assign progress = cart.total_price | times: 100 | divided_by: free_shipping_threshold
        if progress > 100
          assign progress = 100
        endif
      -%}
      <div class="cart-drawer__shipping-bar">
        <div class="cart-drawer__shipping-track">
          <div class="cart-drawer__shipping-fill" style="width: {{ progress }}%;"></div>
        </div>
        <p class="cart-drawer__shipping-text text-caption">
          {%- if remaining > 0 -%}
            {{ 'cart.general.free_shipping_progress' | t: amount: remaining | money }}
          {%- else -%}
            {{ 'cart.general.free_shipping_reached' | t }}
          {%- endif -%}
        </p>
      </div>

      <ul class="cart-drawer__items">
        {%- for item in cart.items -%}
          <li class="cart-drawer__item" data-cart-item data-line="{{ forloop.index }}">
            <a href="{{ item.url }}" class="cart-drawer__item-image">
              {%- render 'responsive-image', image: item.image, ratio: 'square', sizes: '96px' -%}
            </a>
            <div class="cart-drawer__item-details">
              <a href="{{ item.url }}" class="cart-drawer__item-title text-body">{{ item.product.title }}</a>
              {%- unless item.product.has_only_default_variant -%}
                <p class="cart-drawer__item-variant text-caption">{{ item.variant.title }}</p>
              {%- endunless -%}
              {%- render 'price', item: item -%}
              <div class="cart-drawer__item-controls">
                {%- render 'quantity-selector', quantity: item.quantity, line: forloop.index -%}
                <button type="button" class="cart-drawer__item-remove text-caption" data-cart-remove data-line="{{ forloop.index }}">
                  {{ 'cart.general.remove' | t }}
                </button>
              </div>
            </div>
          </li>
        {%- endfor -%}
      </ul>

      <footer class="cart-drawer__footer">
        <div class="cart-drawer__subtotal">
          <span class="text-body">{{ 'cart.general.subtotal' | t }}</span>
          <span class="text-price">{{ cart.total_price | money }}</span>
        </div>
        <a href="{{ routes.cart_url }}" class="button button--secondary cart-drawer__view-cart">{{ 'cart.general.title' | t }}</a>
        <a href="{{ routes.cart_checkout_url }}" class="button button--primary cart-drawer__checkout">{{ 'cart.general.checkout' | t }}</a>
      </footer>
    {%- else -%}
      <div class="cart-drawer__empty">
        <p class="text-body">{{ 'cart.general.empty' | t }}</p>
        <a href="{{ routes.all_products_collection_url }}" class="button button--primary">{{ 'cart.general.continue_shopping' | t }}</a>
      </div>
    {%- endif -%}
  </div>
</cart-drawer>

{% schema %}
{
  "name": "Cart drawer"
}
{% endschema %}
