<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_header_bg }}">
    {%- render 'meta-tags' -%}

    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    {{ content_for_header }}

    <style>
      {%- render 'theme-tokens' -%}
    </style>

    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'header.css' | asset_url | stylesheet_tag }}
    {{ 'footer.css' | asset_url | stylesheet_tag }}
    {{ 'animations.css' | asset_url | stylesheet_tag }}
    {{ 'sections.css' | asset_url | stylesheet_tag }}
    {{ 'components.css' | asset_url | stylesheet_tag }}
    {{ 'sections-extra.css' | asset_url | stylesheet_tag }}
    {{ 'product.css' | asset_url | stylesheet_tag }}
    {{ 'collection.css' | asset_url | stylesheet_tag }}
    {%- if template.name == 'cart' -%}
      {{ 'cart-page.css' | asset_url | stylesheet_tag }}
    {%- endif -%}
    {%- if template.name == 'search' -%}
      {{ 'search.css' | asset_url | stylesheet_tag }}
    {%- endif -%}
    {{ 'blog.css' | asset_url | stylesheet_tag }}
    {%- if template contains 'customers' -%}
      {{ 'customer-account.css' | asset_url | stylesheet_tag }}
    {%- endif -%}

    <script>window.themeMoneyFormat = {{ shop.money_format | json }};</script>

    <script src="{{ 'global.js' | asset_url }}" type="module" defer="defer"></script>
    <script src="{{ 'header.js' | asset_url }}" type="module" defer="defer"></script>
    <script src="{{ 'animations.js' | asset_url }}" type="module" defer="defer"></script>
    <script src="{{ 'quick-add.js' | asset_url }}" type="module" defer="defer"></script>
    <script src="{{ 'quick-view.js' | asset_url }}" type="module" defer="defer"></script>
    <script src="{{ 'predictive-search.js' | asset_url }}" type="module" defer="defer"></script>
    <script src="{{ 'popup.js' | asset_url }}" type="module" defer="defer"></script>
    {%- if template contains 'customers' -%}
      <script src="{{ 'customer-account.js' | asset_url }}" type="module" defer="defer"></script>
    {%- endif -%}
    <script src="{{ 'countdown.js' | asset_url }}" type="module" defer="defer"></script>
    <script src="{{ 'before-after.js' | asset_url }}" type="module" defer="defer"></script>
    <script src="{{ 'tabbed-products.js' | asset_url }}" type="module" defer="defer"></script>
    <script src="{{ 'recently-viewed.js' | asset_url }}" type="module" defer="defer"></script>
    <script src="{{ 'video-section.js' | asset_url }}" type="module" defer="defer"></script>
    {%- if template.name == 'product' -%}
      <script src="{{ 'product-recommendations.js' | asset_url }}" type="module" defer="defer"></script>
    {%- endif -%}
    {%- if template.name == 'collection' or template.name == 'search' -%}
      <script src="{{ 'collection.js' | asset_url }}" type="module" defer="defer"></script>
      <script src="{{ 'facets.js' | asset_url }}" type="module" defer="defer"></script>
    {%- endif -%}
    {%- if template.name == 'cart' -%}
      <script src="{{ 'cart-page.js' | asset_url }}" type="module" defer="defer"></script>
    {%- endif -%}

    <script>document.documentElement.classList.replace('no-js', 'js');</script>
  </head>

  <body class="template-{{ request.page_type | handleize }} hover-style-{{ settings.hover_style }}{% if settings.enable_scroll_reveal %} scroll-reveal-enabled{% endif %}">
    <a class="visually-hidden skip-to-content-link" href="#MainContent">
      {{ 'general.accessibility.skip_to_content' | t }}
    </a>

    {% sections 'header-group' %}

    <main id="MainContent" class="main-content" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% section 'cart-drawer' %}
    {%- render 'search-drawer' -%}
    {%- render 'quick-view-modal' -%}
    {% section 'popup' %}

    {%- if settings.enable_back_to_top -%}
      <button type="button" class="back-to-top" data-back-to-top aria-label="{{ 'general.back_to_top' | t }}" hidden>
        {%- render 'icon-arrow-up' -%}
      </button>
    {%- endif -%}
  </body>
</html>
