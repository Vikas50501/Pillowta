{%- liquid
  assign heading_weight_num = settings.type_heading_weight | plus: 0
  assign body_weight_num = settings.type_body_weight | plus: 0
  assign caption_weight_num = settings.type_caption_weight | plus: 0
  assign blog_weight_num = settings.type_blog_weight | plus: 0
  assign navigation_weight_num = settings.type_navigation_weight | plus: 0
  assign menu_weight_num = settings.type_menu_weight | plus: 0
  assign button_weight_num = settings.type_button_weight | plus: 0
  assign price_weight_num = settings.type_price_weight | plus: 0
  assign badge_weight_num = settings.type_badge_weight | plus: 0
  assign footer_weight_num = settings.type_footer_weight | plus: 0
  assign announcement_weight_num = settings.type_announcement_weight | plus: 0
  assign form_weight_num = settings.type_form_weight | plus: 0

  assign heading_font = settings.type_heading_font | font_modify: 'weight', heading_weight_num
  assign body_font = settings.type_body_font | font_modify: 'weight', body_weight_num
  assign caption_font = settings.type_caption_font | font_modify: 'weight', caption_weight_num
  assign blog_font = settings.type_blog_font | font_modify: 'weight', blog_weight_num
  assign navigation_font = settings.type_navigation_font | font_modify: 'weight', navigation_weight_num
  assign menu_font = settings.type_menu_font | font_modify: 'weight', menu_weight_num
  assign button_font = settings.type_button_font | font_modify: 'weight', button_weight_num
  assign price_font = settings.type_price_font | font_modify: 'weight', price_weight_num
  assign badge_font = settings.type_badge_font | font_modify: 'weight', badge_weight_num
  assign footer_font = settings.type_footer_font | font_modify: 'weight', footer_weight_num
  assign announcement_font = settings.type_announcement_font | font_modify: 'weight', announcement_weight_num
  assign form_font = settings.type_form_font | font_modify: 'weight', form_weight_num
-%}
{{ heading_font | font_face: font_display: 'swap' }}
{{ body_font | font_face: font_display: 'swap' }}
{{ caption_font | font_face: font_display: 'swap' }}
{{ blog_font | font_face: font_display: 'swap' }}
{{ navigation_font | font_face: font_display: 'swap' }}
{{ menu_font | font_face: font_display: 'swap' }}
{{ button_font | font_face: font_display: 'swap' }}
{{ price_font | font_face: font_display: 'swap' }}
{{ badge_font | font_face: font_display: 'swap' }}
{{ footer_font | font_face: font_display: 'swap' }}
{{ announcement_font | font_face: font_display: 'swap' }}
{{ form_font | font_face: font_display: 'swap' }}

:root {
  /* Colors */
  --color-primary: {{ settings.color_primary.red }}, {{ settings.color_primary.green }}, {{ settings.color_primary.blue }};
  --color-secondary: {{ settings.color_secondary.red }}, {{ settings.color_secondary.green }}, {{ settings.color_secondary.blue }};
  --color-accent: {{ settings.color_accent.red }}, {{ settings.color_accent.green }}, {{ settings.color_accent.blue }};
  --color-success: {{ settings.color_success.red }}, {{ settings.color_success.green }}, {{ settings.color_success.blue }};
  --color-warning: {{ settings.color_warning.red }}, {{ settings.color_warning.green }}, {{ settings.color_warning.blue }};
  --color-error: {{ settings.color_error.red }}, {{ settings.color_error.green }}, {{ settings.color_error.blue }};
  --color-background: {{ settings.color_background.red }}, {{ settings.color_background.green }}, {{ settings.color_background.blue }};
  --color-surface: {{ settings.color_surface.red }}, {{ settings.color_surface.green }}, {{ settings.color_surface.blue }};
  --color-card: {{ settings.color_card.red }}, {{ settings.color_card.green }}, {{ settings.color_card.blue }};
  --color-border: {{ settings.color_border.red }}, {{ settings.color_border.green }}, {{ settings.color_border.blue }};
  --color-overlay: {{ settings.color_overlay }};
  --color-button-bg: {{ settings.color_button_bg.red }}, {{ settings.color_button_bg.green }}, {{ settings.color_button_bg.blue }};
  --color-button-text: {{ settings.color_button_text.red }}, {{ settings.color_button_text.green }}, {{ settings.color_button_text.blue }};
  --color-button-hover: {{ settings.color_button_hover.red }}, {{ settings.color_button_hover.green }}, {{ settings.color_button_hover.blue }};
  --color-link: {{ settings.color_link.red }}, {{ settings.color_link.green }}, {{ settings.color_link.blue }};
  --color-heading: {{ settings.color_heading.red }}, {{ settings.color_heading.green }}, {{ settings.color_heading.blue }};
  --color-body-text: {{ settings.color_body_text.red }}, {{ settings.color_body_text.green }}, {{ settings.color_body_text.blue }};
  --color-header-bg: {{ settings.color_header_bg.red }}, {{ settings.color_header_bg.green }}, {{ settings.color_header_bg.blue }};
  --color-header-text: {{ settings.color_header_text.red }}, {{ settings.color_header_text.green }}, {{ settings.color_header_text.blue }};
  --color-footer-bg: {{ settings.color_footer_bg.red }}, {{ settings.color_footer_bg.green }}, {{ settings.color_footer_bg.blue }};
  --color-footer-text: {{ settings.color_footer_text.red }}, {{ settings.color_footer_text.green }}, {{ settings.color_footer_text.blue }};
  --color-announcement-bg: {{ settings.color_announcement_bg.red }}, {{ settings.color_announcement_bg.green }}, {{ settings.color_announcement_bg.blue }};
  --color-announcement-text: {{ settings.color_announcement_text.red }}, {{ settings.color_announcement_text.green }}, {{ settings.color_announcement_text.blue }};
  --color-sale: {{ settings.color_sale.red }}, {{ settings.color_sale.green }}, {{ settings.color_sale.blue }};
  --color-compare-price: {{ settings.color_compare_price.red }}, {{ settings.color_compare_price.green }}, {{ settings.color_compare_price.blue }};
  --color-badge-bg: {{ settings.color_badge_bg.red }}, {{ settings.color_badge_bg.green }}, {{ settings.color_badge_bg.blue }};
  --color-badge-text: {{ settings.color_badge_text.red }}, {{ settings.color_badge_text.green }}, {{ settings.color_badge_text.blue }};
  --color-icons: {{ settings.color_icons.red }}, {{ settings.color_icons.green }}, {{ settings.color_icons.blue }};
  --color-input-bg: {{ settings.color_input_bg.red }}, {{ settings.color_input_bg.green }}, {{ settings.color_input_bg.blue }};
  --color-input-border: {{ settings.color_input_border.red }}, {{ settings.color_input_border.green }}, {{ settings.color_input_border.blue }};
  --color-input-text: {{ settings.color_input_text.red }}, {{ settings.color_input_text.green }}, {{ settings.color_input_text.blue }};
  --color-drawer-bg: {{ settings.color_drawer_bg.red }}, {{ settings.color_drawer_bg.green }}, {{ settings.color_drawer_bg.blue }};
  --color-popup-bg: {{ settings.color_popup_bg.red }}, {{ settings.color_popup_bg.green }}, {{ settings.color_popup_bg.blue }};
  --color-mega-menu-bg: {{ settings.color_mega_menu_bg.red }}, {{ settings.color_mega_menu_bg.green }}, {{ settings.color_mega_menu_bg.blue }};

  /* Typography */
  --font-heading-family: {{ heading_font.family }}, {{ heading_font.fallback_families }};
  --font-heading-style: {{ heading_font.style }};
  --font-heading-size-desktop: {{ settings.type_heading_size_desktop }}px;
  --font-heading-size-tablet: {{ settings.type_heading_size_tablet }}px;
  --font-heading-size-mobile: {{ settings.type_heading_size_mobile }}px;
  --font-heading-line-height: {{ settings.type_heading_line_height }};
  --font-heading-letter-spacing: {{ settings.type_heading_letter_spacing }}px;
  --font-heading-transform: {{ settings.type_heading_transform }};

  --font-body-family: {{ body_font.family }}, {{ body_font.fallback_families }};
  --font-body-style: {{ body_font.style }};
  --font-body-size-desktop: {{ settings.type_body_size_desktop }}px;
  --font-body-size-tablet: {{ settings.type_body_size_tablet }}px;
  --font-body-size-mobile: {{ settings.type_body_size_mobile }}px;
  --font-body-line-height: {{ settings.type_body_line_height }};
  --font-body-letter-spacing: {{ settings.type_body_letter_spacing }}px;
  --font-body-transform: {{ settings.type_body_transform }};

  --font-caption-family: {{ caption_font.family }}, {{ caption_font.fallback_families }};
  --font-caption-style: {{ caption_font.style }};
  --font-caption-size-desktop: {{ settings.type_caption_size_desktop }}px;
  --font-caption-size-tablet: {{ settings.type_caption_size_tablet }}px;
  --font-caption-size-mobile: {{ settings.type_caption_size_mobile }}px;
  --font-caption-line-height: {{ settings.type_caption_line_height }};
  --font-caption-letter-spacing: {{ settings.type_caption_letter_spacing }}px;
  --font-caption-transform: {{ settings.type_caption_transform }};

  --font-blog-family: {{ blog_font.family }}, {{ blog_font.fallback_families }};
  --font-blog-style: {{ blog_font.style }};
  --font-blog-size-desktop: {{ settings.type_blog_size_desktop }}px;
  --font-blog-size-tablet: {{ settings.type_blog_size_tablet }}px;
  --font-blog-size-mobile: {{ settings.type_blog_size_mobile }}px;
  --font-blog-line-height: {{ settings.type_blog_line_height }};
  --font-blog-letter-spacing: {{ settings.type_blog_letter_spacing }}px;
  --font-blog-transform: {{ settings.type_blog_transform }};

  --font-navigation-family: {{ navigation_font.family }}, {{ navigation_font.fallback_families }};
  --font-navigation-style: {{ navigation_font.style }};
  --font-navigation-size-desktop: {{ settings.type_navigation_size_desktop }}px;
  --font-navigation-size-tablet: {{ settings.type_navigation_size_tablet }}px;
  --font-navigation-size-mobile: {{ settings.type_navigation_size_mobile }}px;
  --font-navigation-line-height: {{ settings.type_navigation_line_height }};
  --font-navigation-letter-spacing: {{ settings.type_navigation_letter_spacing }}px;
  --font-navigation-transform: {{ settings.type_navigation_transform }};

  --font-menu-family: {{ menu_font.family }}, {{ menu_font.fallback_families }};
  --font-menu-style: {{ menu_font.style }};
  --font-menu-size-desktop: {{ settings.type_menu_size_desktop }}px;
  --font-menu-size-tablet: {{ settings.type_menu_size_tablet }}px;
  --font-menu-size-mobile: {{ settings.type_menu_size_mobile }}px;
  --font-menu-line-height: {{ settings.type_menu_line_height }};
  --font-menu-letter-spacing: {{ settings.type_menu_letter_spacing }}px;
  --font-menu-transform: {{ settings.type_menu_transform }};

  --font-button-family: {{ button_font.family }}, {{ button_font.fallback_families }};
  --font-button-style: {{ button_font.style }};
  --font-button-size-desktop: {{ settings.type_button_size_desktop }}px;
  --font-button-size-tablet: {{ settings.type_button_size_tablet }}px;
  --font-button-size-mobile: {{ settings.type_button_size_mobile }}px;
  --font-button-line-height: {{ settings.type_button_line_height }};
  --font-button-letter-spacing: {{ settings.type_button_letter_spacing }}px;
  --font-button-transform: {{ settings.type_button_transform }};

  --font-price-family: {{ price_font.family }}, {{ price_font.fallback_families }};
  --font-price-style: {{ price_font.style }};
  --font-price-size-desktop: {{ settings.type_price_size_desktop }}px;
  --font-price-size-tablet: {{ settings.type_price_size_tablet }}px;
  --font-price-size-mobile: {{ settings.type_price_size_mobile }}px;
  --font-price-line-height: {{ settings.type_price_line_height }};
  --font-price-letter-spacing: {{ settings.type_price_letter_spacing }}px;
  --font-price-transform: {{ settings.type_price_transform }};

  --font-badge-family: {{ badge_font.family }}, {{ badge_font.fallback_families }};
  --font-badge-style: {{ badge_font.style }};
  --font-badge-size-desktop: {{ settings.type_badge_size_desktop }}px;
  --font-badge-size-tablet: {{ settings.type_badge_size_tablet }}px;
  --font-badge-size-mobile: {{ settings.type_badge_size_mobile }}px;
  --font-badge-line-height: {{ settings.type_badge_line_height }};
  --font-badge-letter-spacing: {{ settings.type_badge_letter_spacing }}px;
  --font-badge-transform: {{ settings.type_badge_transform }};

  --font-footer-family: {{ footer_font.family }}, {{ footer_font.fallback_families }};
  --font-footer-style: {{ footer_font.style }};
  --font-footer-size-desktop: {{ settings.type_footer_size_desktop }}px;
  --font-footer-size-tablet: {{ settings.type_footer_size_tablet }}px;
  --font-footer-size-mobile: {{ settings.type_footer_size_mobile }}px;
  --font-footer-line-height: {{ settings.type_footer_line_height }};
  --font-footer-letter-spacing: {{ settings.type_footer_letter_spacing }}px;
  --font-footer-transform: {{ settings.type_footer_transform }};

  --font-announcement-family: {{ announcement_font.family }}, {{ announcement_font.fallback_families }};
  --font-announcement-style: {{ announcement_font.style }};
  --font-announcement-size-desktop: {{ settings.type_announcement_size_desktop }}px;
  --font-announcement-size-tablet: {{ settings.type_announcement_size_tablet }}px;
  --font-announcement-size-mobile: {{ settings.type_announcement_size_mobile }}px;
  --font-announcement-line-height: {{ settings.type_announcement_line_height }};
  --font-announcement-letter-spacing: {{ settings.type_announcement_letter_spacing }}px;
  --font-announcement-transform: {{ settings.type_announcement_transform }};

  --font-form-family: {{ form_font.family }}, {{ form_font.fallback_families }};
  --font-form-style: {{ form_font.style }};
  --font-form-size-desktop: {{ settings.type_form_size_desktop }}px;
  --font-form-size-tablet: {{ settings.type_form_size_tablet }}px;
  --font-form-size-mobile: {{ settings.type_form_size_mobile }}px;
  --font-form-line-height: {{ settings.type_form_line_height }};
  --font-form-letter-spacing: {{ settings.type_form_letter_spacing }}px;
  --font-form-transform: {{ settings.type_form_transform }};

  /* Layout */
  --container-width: {{ settings.layout_container_width }}px;
  --max-content-width: {{ settings.layout_max_content_width }}px;
  --spacing-section-desktop: {{ settings.spacing_section_desktop }}px;
  --spacing-section-tablet: {{ settings.spacing_section_tablet }}px;
  --spacing-section-mobile: {{ settings.spacing_section_mobile }}px;
  --spacing-grid: {{ settings.spacing_grid }}px;

  /* Radius, sizing, shadow */
  --radius-global: {{ settings.radius_global }}px;
  --radius-button: {{ settings.radius_button }}px;
  --radius-input: {{ settings.radius_input }}px;
  --radius-image: {{ settings.radius_image }}px;
  --button-height: {{ settings.button_height }}px;
  --icon-size: {{ settings.icon_size }}px;
  {%- case settings.shadow_preset -%}
    {%- when 'none' -%}
      --shadow: none;
    {%- when 'md' -%}
      --shadow: 0 4px 16px rgba(0, 0, 0, 0.12);
    {%- when 'lg' -%}
      --shadow: 0 12px 32px rgba(0, 0, 0, 0.16);
    {%- else -%}
      --shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  {%- endcase -%}

  /* Motion */
  --speed-animation: {{ settings.speed_animation }}ms;
  --speed-transition: {{ settings.speed_transition }}ms;
}
