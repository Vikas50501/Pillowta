{%- comment -%}
  Renders a BreadcrumbList matching the current template context. No params —
  reads the global `template`/`product`/`collection`/`page`/`blog`/`article`
  objects directly, so it can be safely rendered once from meta-tags.liquid.
{%- endcomment -%}
{%- liquid
  assign position = 1
-%}
{%- capture breadcrumb_items -%}
  {
    "@type": "ListItem",
    "position": {{ position }},
    "name": {{ shop.name | json }},
    "item": {{ request.origin | append: routes.root_url | json }}
  }
  {%- assign position = position | plus: 1 -%}

  {%- if template.name == 'product' -%}
    {%- if collection.title -%}
      ,{
        "@type": "ListItem",
        "position": {{ position }},
        "name": {{ collection.title | json }},
        "item": {{ request.origin | append: collection.url | json }}
      }
      {%- assign position = position | plus: 1 -%}
    {%- endif -%}
    ,{
      "@type": "ListItem",
      "position": {{ position }},
      "name": {{ product.title | json }},
      "item": {{ request.origin | append: product.url | json }}
    }

  {%- elsif template.name == 'collection' -%}
    ,{
      "@type": "ListItem",
      "position": {{ position }},
      "name": {{ collection.title | json }},
      "item": {{ request.origin | append: collection.url | json }}
    }

  {%- elsif template.name == 'page' -%}
    ,{
      "@type": "ListItem",
      "position": {{ position }},
      "name": {{ page.title | json }},
      "item": {{ request.origin | append: page.url | json }}
    }

  {%- elsif template.name == 'article' -%}
    {%- if blog.title -%}
      ,{
        "@type": "ListItem",
        "position": {{ position }},
        "name": {{ blog.title | json }},
        "item": {{ request.origin | append: blog.url | json }}
      }
      {%- assign position = position | plus: 1 -%}
    {%- endif -%}
    ,{
      "@type": "ListItem",
      "position": {{ position }},
      "name": {{ article.title | json }},
      "item": {{ request.origin | append: article.url | json }}
    }

  {%- elsif template.name == 'blog' -%}
    ,{
      "@type": "ListItem",
      "position": {{ position }},
      "name": {{ blog.title | json }},
      "item": {{ request.origin | append: blog.url | json }}
    }
  {%- endif -%}
{%- endcapture -%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [{{ breadcrumb_items }}]
  }
</script>
