<search-drawer class="search-drawer color-popup" id="SearchDrawer" aria-hidden="true">
  <div class="search-drawer__overlay" data-search-close></div>
  <div class="search-drawer__panel" role="dialog" aria-modal="true" aria-label="{{ 'general.search.submit' | t }}">
    <button type="button" class="search-drawer__close" data-search-close aria-label="{{ 'general.accessibility.close_search' | t }}">
      {%- render 'icon-close' -%}
    </button>

    <form
      action="{{ routes.search_url }}"
      method="get"
      role="search"
      class="search-drawer__form"
      data-predictive-search-url="{{ routes.predictive_search_url }}"
    >
      <div class="search-drawer__field">
        {%- render 'icon-search' -%}
        <input
          type="search"
          name="q"
          value="{{ search.terms | escape }}"
          placeholder="{{ 'general.search.placeholder' | t }}"
          class="search-drawer__input text-body"
          autocomplete="off"
          data-search-input
          aria-label="{{ 'general.search.placeholder' | t }}"
        >
        <input type="hidden" name="type" value="product,article,page,collection">
      </div>
      <button type="submit" class="visually-hidden">{{ 'general.search.submit' | t }}</button>
    </form>

    <div class="search-drawer__results" data-search-results aria-live="polite"></div>
  </div>
</search-drawer>
