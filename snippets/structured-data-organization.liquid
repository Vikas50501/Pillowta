<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    "url": {{ shop.url | json }}
    {%- if settings.social_instagram != blank or settings.social_facebook != blank or settings.social_tiktok != blank or settings.social_twitter != blank or settings.social_youtube != blank or settings.social_pinterest != blank -%}
    ,"sameAs": [
      {%- assign socials = '' -%}
      {%- capture socials -%}
        {%- if settings.social_instagram != blank -%}{{ settings.social_instagram | json }},{%- endif -%}
        {%- if settings.social_facebook != blank -%}{{ settings.social_facebook | json }},{%- endif -%}
        {%- if settings.social_tiktok != blank -%}{{ settings.social_tiktok | json }},{%- endif -%}
        {%- if settings.social_twitter != blank -%}{{ settings.social_twitter | json }},{%- endif -%}
        {%- if settings.social_youtube != blank -%}{{ settings.social_youtube | json }},{%- endif -%}
        {%- if settings.social_pinterest != blank -%}{{ settings.social_pinterest | json }},{%- endif -%}
      {%- endcapture -%}
      {{ socials | remove_last: ',' }}
    ]
    {%- endif -%}
  }
</script>
