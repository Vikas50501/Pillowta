{%- comment -%} Params: blocks (an array of blocks with .settings.question / .settings.answer) {%- endcomment -%}
{%- if blocks.size > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in blocks -%}
          {
            "@type": "Question",
            "name": {{ block.settings.question | json }},
            "acceptedAnswer": {
              "@type": "Answer",
              "text": {{ block.settings.answer | strip_html | json }}
            }
          }{%- unless forloop.last %},{% endunless -%}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}
