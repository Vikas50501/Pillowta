{%- comment -%}
  Params: product
  Renders one fieldset per option. Color/Colour options render as swatches,
  everything else as pill buttons. JS (assets/product-form.js) listens for
  changes on [data-option-value] and recomputes the matching variant using
  the JSON blob rendered by this snippet.
{%- endcomment -%}
<variant-picker class="variant-picker" data-variant-picker>
  <script type="application/json" data-product-variants-json>
    {{ product.variants | json }}
  </script>
  <script type="application/json" data-product-url-json>
    {{ product.url | json }}
  </script>

  {%- for option in product.options_with_values -%}
    {%- assign is_color = false -%}
    {%- if option.name == 'Color' or option.name == 'Colour' -%}
      {%- assign is_color = true -%}
    {%- endif -%}
    <fieldset class="variant-picker__option" data-option-index="{{ forloop.index0 }}">
      <legend class="variant-picker__option-name text-body">
        {{ option.name }}: <span data-selected-value>{{ option.selected_value.name | default: option.selected_value }}</span>
      </legend>
      <div class="variant-picker__values">
        {%- for value in option.values -%}
          {%- liquid
            assign value_name = value.name | default: value
            assign input_id = 'OptionValue-' | append: product.id | append: '-' | append: forloop.parentloop.index0 | append: '-' | append: forloop.index0
            assign is_checked = false
            if option.selected_value.name == value_name or option.selected_value == value_name
              assign is_checked = true
            endif
          -%}
          <input
            type="radio"
            id="{{ input_id }}"
            name="option-{{ forloop.parentloop.index0 }}"
            value="{{ value_name | escape }}"
            {% if is_checked %}checked{% endif %}
            class="visually-hidden variant-picker__radio"
            data-option-value
          >
          <label for="{{ input_id }}" class="variant-picker__value-label{% if is_color %} variant-picker__value-label--swatch{% endif %}">
            {%- if is_color -%}
              {%- render 'swatch', option_value: value, selected: is_checked -%}
              <span class="visually-hidden">{{ value_name }}</span>
            {%- else -%}
              <span class="text-body">{{ value_name }}</span>
            {%- endif -%}
          </label>
        {%- endfor -%}
      </div>
    </fieldset>
  {%- endfor -%}
</variant-picker>
