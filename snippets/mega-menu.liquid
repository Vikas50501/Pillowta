{%- comment -%}
  Renders the mega menu panel for a single top-level navigation item.

  Accepts:
    - link: {Object} the top-level menu link this panel belongs to
    - blocks: {Array} section.blocks, filtered here by matching parent_title
    - section_id: {String} the parent section id, used to build unique ids
    - index: {Number} the loop index of the link, used to build unique ids
{%- endcomment -%}

{%- liquid
  assign link_title_down = link.title | downcase
  assign menu_columns = blocks | where: 'type', 'menu_column'
  assign image_cards = blocks | where: 'type', 'image_card'
  assign promo_banners = blocks | where: 'type', 'promo_banner'
  assign rich_texts = blocks | where: 'type', 'rich_text'
-%}

<div
  class="mega-menu"
  id="MegaMenu-{{ section_id }}-{{ index }}"
  data-mega-menu
  role="region"
  aria-label="{{ link.title | escape }}"
>
  <div class="mega-menu__wrapper">
    <div class="mega-menu__columns">
      {%- for block in menu_columns -%}
        {%- if block.settings.parent_title | downcase == link_title_down -%}
          <div class="mega-menu__column" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              <div class="mega-menu__column-image">
                {{
                  block.settings.image
                  | image_url: width: 400
                  | image_tag: loading: 'lazy', sizes: '200px', widths: '200, 300, 400'
                }}
              </div>
            {%- endif -%}
            {%- if block.settings.title != blank -%}
              <h3 class="mega-menu__column-title">{{ block.settings.title | escape }}</h3>
            {%- endif -%}
            {%- if block.settings.menu != blank -%}
              <ul class="mega-menu__linklist" role="list">
                {%- for childlink in block.settings.menu.links -%}
                  <li class="mega-menu__linklist-item">
                    <a
                      href="{{ childlink.url }}"
                      class="mega-menu__link"
                      {% if childlink.current %}aria-current="page"{% endif %}
                    >
                      {{ childlink.title | escape }}
                    </a>
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}

      {%- for block in image_cards -%}
        {%- if block.settings.parent_title | downcase == link_title_down -%}
          <a
            href="{{ block.settings.link | default: '#' }}"
            class="mega-menu__column mega-menu__column--card"
            {{ block.shopify_attributes }}
          >
            <span class="mega-menu__card-image">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 400
                  | image_tag: loading: 'lazy', sizes: '200px', widths: '200, 300, 400'
                }}
              {%- endif -%}
            </span>
            {%- if block.settings.title != blank -%}
              <span class="mega-menu__card-title">{{ block.settings.title | escape }}</span>
            {%- endif -%}
          </a>
        {%- endif -%}
      {%- endfor -%}

      {%- for block in rich_texts -%}
        {%- if block.settings.parent_title | downcase == link_title_down -%}
          <div class="mega-menu__column mega-menu__column--richtext" {{ block.shopify_attributes }}>
            {%- if block.settings.text != blank -%}
              <div class="mega-menu__richtext">{{ block.settings.text }}</div>
            {%- endif -%}
            {%- if block.settings.button_label != blank -%}
              <a href="{{ block.settings.button_link | default: '#' }}" class="mega-menu__button">
                {{ block.settings.button_label | escape }}
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- if promo_banners.size > 0 -%}
      <div class="mega-menu__promos{% if promo_banners.size > 1 %} mega-menu__promos--stacked{% endif %}">
        {%- for block in promo_banners -%}
          {%- if block.settings.parent_title | downcase == link_title_down -%}
            <a
              href="{{ block.settings.link | default: '#' }}"
              class="mega-menu__promo mega-menu__promo--{{ block.settings.text_color }}"
              {{ block.shopify_attributes }}
            >
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 800
                  | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 400px, 100vw', widths: '400, 600, 800'
                }}
              {%- endif -%}
              {%- if block.settings.heading != blank or block.settings.subheading != blank -%}
                <span class="mega-menu__promo-content">
                  {%- if block.settings.heading != blank -%}
                    <span class="mega-menu__promo-heading">{{ block.settings.heading | escape }}</span>
                  {%- endif -%}
                  {%- if block.settings.subheading != blank -%}
                    <span class="mega-menu__promo-subheading">{{ block.settings.subheading | escape }}</span>
                  {%- endif -%}
                </span>
              {%- endif -%}
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>
