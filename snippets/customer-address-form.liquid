{%- comment -%}
  Params: address (customer.new_address for a blank form, or an existing
  customer.addresses[n] to edit), form (the enclosing {% form 'customer_address' %} object)
{%- endcomment -%}
<div class="address-form__grid">
  <div class="address-form__field">
    <label class="text-form" for="AddressFirstName{{ address.id }}">{{ 'customer.address_form.first_name' | t }}</label>
    <input type="text" id="AddressFirstName{{ address.id }}" name="address[first_name]" value="{{ address.first_name }}" autocomplete="given-name">
  </div>
  <div class="address-form__field">
    <label class="text-form" for="AddressLastName{{ address.id }}">{{ 'customer.address_form.last_name' | t }}</label>
    <input type="text" id="AddressLastName{{ address.id }}" name="address[last_name]" value="{{ address.last_name }}" autocomplete="family-name">
  </div>
  <div class="address-form__field address-form__field--full">
    <label class="text-form" for="AddressCompany{{ address.id }}">{{ 'customer.address_form.company' | t }}</label>
    <input type="text" id="AddressCompany{{ address.id }}" name="address[company]" value="{{ address.company }}" autocomplete="organization">
  </div>
  <div class="address-form__field address-form__field--full">
    <label class="text-form" for="AddressAddress1{{ address.id }}">{{ 'customer.address_form.address1' | t }}</label>
    <input type="text" id="AddressAddress1{{ address.id }}" name="address[address1]" value="{{ address.address1 }}" autocomplete="address-line1">
  </div>
  <div class="address-form__field address-form__field--full">
    <label class="text-form" for="AddressAddress2{{ address.id }}">{{ 'customer.address_form.address2' | t }}</label>
    <input type="text" id="AddressAddress2{{ address.id }}" name="address[address2]" value="{{ address.address2 }}" autocomplete="address-line2">
  </div>
  <div class="address-form__field">
    <label class="text-form" for="AddressCity{{ address.id }}">{{ 'customer.address_form.city' | t }}</label>
    <input type="text" id="AddressCity{{ address.id }}" name="address[city]" value="{{ address.city }}" autocomplete="address-level2">
  </div>
  <div class="address-form__field">
    <label class="text-form" for="AddressCountry{{ address.id }}">{{ 'customer.address_form.country' | t }}</label>
    <select id="AddressCountry{{ address.id }}" name="address[country]" data-address-country autocomplete="country" class="text-form">
      {{ form.country_option_tags }}
    </select>
  </div>
  <div class="address-form__field" data-address-province-wrapper>
    <label class="text-form" for="AddressProvince{{ address.id }}">{{ 'customer.address_form.province' | t }}</label>
    <input type="text" id="AddressProvince{{ address.id }}" name="address[province]" value="{{ address.province }}" autocomplete="address-level1">
  </div>
  <div class="address-form__field">
    <label class="text-form" for="AddressZip{{ address.id }}">{{ 'customer.address_form.zip' | t }}</label>
    <input type="text" id="AddressZip{{ address.id }}" name="address[zip]" value="{{ address.zip }}" autocomplete="postal-code">
  </div>
  <div class="address-form__field">
    <label class="text-form" for="AddressPhone{{ address.id }}">{{ 'customer.address_form.phone' | t }}</label>
    <input type="tel" id="AddressPhone{{ address.id }}" name="address[phone]" value="{{ address.phone }}" autocomplete="tel">
  </div>
  <div class="address-form__field address-form__field--full address-form__field--checkbox">
    <label class="text-form">
      <input type="checkbox" name="address[default]" value="1" {% if address.default %}checked{% endif %}>
      {{ 'customer.address_form.set_default' | t }}
    </label>
  </div>
</div>
