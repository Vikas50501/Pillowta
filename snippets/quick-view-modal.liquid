<quick-view-modal class="quick-view-modal color-popup" id="QuickViewModal" aria-hidden="true">
  <div class="quick-view-modal__overlay" data-quick-view-close></div>
  <div class="quick-view-modal__panel" role="dialog" aria-modal="true" aria-label="{{ 'products.product.quick_view' | t }}">
    <button type="button" class="quick-view-modal__close" data-quick-view-close aria-label="{{ 'general.accessibility.close' | t }}">
      {%- render 'icon-close' -%}
    </button>
    <div class="quick-view-modal__content" data-quick-view-content>
      <div class="quick-view-modal__loading">
        <span class="spinner"></span>
        <p class="text-caption">{{ 'products.product.quick_view_loading' | t }}</p>
      </div>
    </div>
  </div>
</quick-view-modal>
