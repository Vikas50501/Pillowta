{%- comment -%}
  Params: product
  Renders the PDP media gallery: main stage (one media visible at a time,
  swapped by JS), thumbnail rail, and a click-to-zoom lightbox.
{%- endcomment -%}
<product-gallery class="product-gallery" data-gallery>
  <div class="product-gallery__stage">
    {%- for media in product.media -%}
      {%- assign eager_load = 'lazy' -%}
      {%- if forloop.first -%}{%- assign eager_load = 'eager' -%}{%- endif -%}
      <div
        class="product-gallery__slide{% if forloop.first %} is-active{% endif %}"
        data-gallery-slide
        data-media-id="{{ media.id }}"
      >
        <button type="button" class="product-gallery__zoom-trigger" data-gallery-zoom aria-label="{{ 'products.product.view_details' | t }}">
          {{ media | media_tag: image_size: '1200x1200', loading: eager_load }}
        </button>
      </div>
    {%- else -%}
      <div class="product-gallery__slide is-active">
        <div class="product-gallery__placeholder"></div>
      </div>
    {%- endfor -%}
  </div>

  {%- if product.media.size > 1 -%}
    <div class="product-gallery__thumbs" role="tablist">
      {%- for media in product.media -%}
        <button
          type="button"
          class="product-gallery__thumb{% if forloop.first %} is-active{% endif %}"
          data-gallery-thumb
          data-media-id="{{ media.id }}"
          role="tab"
          aria-selected="{{ forloop.first }}"
        >
          {{ media.preview_image | image_url: width: 160 | image_tag: width: 80, height: 80, alt: media.alt, loading: 'lazy' }}
        </button>
      {%- endfor -%}
    </div>
  {%- endif -%}

  <div class="product-gallery__lightbox" data-gallery-lightbox aria-hidden="true">
    <div class="product-gallery__lightbox-overlay" data-gallery-lightbox-close></div>
    <button type="button" class="product-gallery__lightbox-close" data-gallery-lightbox-close aria-label="{{ 'general.accessibility.close' | t }}">
      {%- render 'icon-close' -%}
    </button>
    <div class="product-gallery__lightbox-stage" data-gallery-lightbox-stage></div>
  </div>
</product-gallery>
